#loading packages
library(ggplot2)
library(ratdat)
?complete_old
View(complete_old)
str(complete_old)
#to wrap texts
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length, fill = plot_type)) +
geom_boxplot() +
scale_x_discrete(labels = label_wrap_gen(width = 10))
#to wrap texts
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length, fill = plot_type)) +
geom_boxplot() +
geom_point(alpha=0.2)
#Adding geoms
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot() +
geom_point(alpha = 0.2)
#to jitter
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot() +
geom_jitter(alpha = 0.2)
#if we want to ignore outliers
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot(outliers = FALSE) +
geom_jitter(alpha = 0.2)
#to add colors
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length, color = plot_type)) +
geom_boxplot(outliers = FALSE) +
geom_jitter(alpha = 0.2)
#to add aesthetic
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot(outliers = FALSE) +
geom_jitter(aes(color = plot_type), alpha = 0.2)
#to show the box plot lines
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(aes(color = plot_type), alpha = 0.2) +
geom_boxplot(outliers = FALSE, fill = NA)
#to show the box plot lines
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(aes(color = plot_type), alpha = 0.2) +
geom_boxplot(outliers = FALSE)
#to remove white complete fill from boxplots
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(aes(color = plot_type), alpha = 0.2) +
geom_boxplot(outliers = FALSE, fill = NA)
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_violinplot()
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_violin()
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_violin(alpha = 0.2, color = "blue")
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(alpha=0.2, aes(color=plot_type))+
geom_violin(fill=NA)
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(alpha=0.2, aes(color=plot_type))+
geom_violin()
#To create violin plot
ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_jitter(alpha=0.2, aes(color=plot_type))+
geom_violin(fill=NA)
#to save in environment
myplot<-ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot() +
geom_point(alpha = 0.2)
#changing theme
myplot + theme_bw()
#changing theme
myplot<-ggplot(data = complete_old, mapping = aes(x = plot_type, y = hindfoot_length)) +
geom_boxplot() +
geom_point(alpha = 0.2)
myplot + theme_bw()
theme_bw()
