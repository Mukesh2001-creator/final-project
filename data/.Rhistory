legend.position = "none")
labs(title="Rodent size bt=y plot type", x= "Plot Type", y+"Hindfoot length (mm)")
labs(title="Rodent size bt=y plot type", x= "Plot Type", y="Hindfoot length (mm)")
#to remove legends
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
panel.grid.major.x = element_blank(),
legend.position = "none")
#to change labels
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
panel.grid.major.x = element_blank(),
legend.position = "none")
labs(title="Rodent size bt=y plot type", x= "Plot Type", y="Hindfoot length (mm)")
#to change labels
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
panel.grid.major.x = element_blank(),
legend.position = "none")+
labs(title="Rodent size bt=y plot type", x= "Plot Type", y="Hindfoot length (mm)")
#to change labels
myplot +
scale_x_discrete(laels=label_wrap_gen(width=10))+
theme_bw() +
theme(axis.title = element_text(size = 14),
panel.grid.major.x = element_blank(),
legend.position = "none")+
labs(title="Rodent size bt=y plot type", x= "Plot Type", y="Hindfoot length (mm)")
#to add subtitle
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
panel.grid.major.x = element_blank(),
legend.position = "none")+
labs(title="Rodent size by plot type", subtitle ="Rodent size and their hindleg length" , x= "Plot Type", y="Hindfoot length (mm)")
#to add subtitle and to make bold
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
plot.title=element_text(face="bold",size=20)
panel.grid.major.x = element_blank(),
#to add subtitle and to make bold
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
plot.title=element_text(face="bold",size=20))
#to add subtitle and to make bold
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14), legend.position = "none",
plot.title = element_text(face = "bold", size = 20)) +
labs(title = "Rodent size by plot type",
subtitle = "Long-term dataset from Portal, AZ",
x = "Plot type",
y = "Hindfoot length (mm)")
#Facetting
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
legend.position = "none",
panel.grid.major.x = element_blank()) +
labs(title = "Rodent size by plot type",
x = "Plot type",
y = "Hindfoot length (mm)",
color = "Plot type") +
facet_wrap(vars(sex), ncol = 1)
#Facetting
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
legend.position = "none",
panel.grid.major.x = element_blank()) +
labs(title = "Rodent size by plot type",
x = "Plot type",
y = "Hindfoot length (mm)",
color = "Plot type") +
facet_wrap(vars(genus), ncol = 1)
#Facetting
myplot +
theme_bw() +
theme(axis.title = element_text(size = 14),
legend.position = "none",
panel.grid.major.x = element_blank()) +
labs(title = "Rodent size by plot type",
x = "Plot type",
y = "Hindfoot length (mm)",
color = "Plot type") +
facet_wrap(vars(taxa), ncol = 1)
