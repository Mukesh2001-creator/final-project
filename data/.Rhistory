ggplot(data = complete_old, mapping = aes(x = weight, y = sex)) +
geom_point()
#to get clear output
ggplot(data = complete_old, mapping = aes(x = weight, y = sex)) +
geom_point(alpha = 0.2)
#to add colors
ggplot(data = complete_old, mapping = aes(x = weight, y = sex)) +
geom_point(alpha = 0.2, color = "blue")
#add different colors
ggplot(data = complete_old, mapping = aes(x = weight, y = sex, color = plot_type)) +
geom_point(alpha = 0.2)
ggplot(data = complete_old,
mapping = aes(x = weight, y = sex, shape = sex)) +
geom_point(alpha = 0.2)
ggplot(data = complete_old,
mapping = aes(x = weight, y = sex, shape = sex)) +
geom_point(alpha = 0.2)
ggplot(data = complete_old,
mapping = aes(x = weight, y = sex, color = year)) +
geom_point(alpha = 0.2)+scale_color_viridis_b()+scale_x_log10()
